# Hostinger MySQL (use a dedicated user; remote access must be enabled for the Vercel origin)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME
# DATABASE_SSL=1

# Silogtran
SILOG_BASE_URL=https://construproyec.colombiasoftware.net
# SOPORTE_SUFIJO=57

# Signs the browser session cookie. Generate: openssl rand -hex 32
TOKEN_SECRET=

# Protects /config.html (header x-admin-key). Generate: openssl rand -hex 12
ADMIN_KEY=

# AI reading of the scanned PDFs
ANTHROPIC_API_KEY=
# IA_MODELO=claude-sonnet-5-5

# Optional
# WAF_WAIT_SEC=30
# SILOG_TIMEOUT_SEC=45
# Local development only (never on Vercel): ACTAS_MOCK=1 uses fixtures/ instead of Silogtran and the AI; WAF_CHROME_PATH=/path/to/chrome

# Optional one-time seed of the fixed values per acta type (JSON {TIPO:{...}}); only applied when acta_tipos is empty
# ACTAS_SEED=
